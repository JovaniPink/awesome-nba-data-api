{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "constraints": {
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements(?:-dev)?\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  }
}
